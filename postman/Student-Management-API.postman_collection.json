          "raw": "{\n  \"name\": \"张三\",\n  \"gender\": \"男\",\n  \"age\": 21,\n  \"major\": \"计算机科学与技术\",\n  \"className\": \"计科2021-1班\",\n  \"phone\": \"13800138001\",\n  \"email\": \"zhangsan_new@example.com\",\n  \"enrollmentDate\": \"2021-09-01\"\n}"
